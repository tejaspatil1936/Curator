# Template for api/.env — the only real env file. api/.env is gitignored; never commit it.
# `make up` creates api/.env from this file on first run, with a random POSTGRES_PASSWORD.
# Both curator-db and curator-api read api/.env.

# Postgres. Read by curator-db only when it initialises an empty volume, so changing
# these after the first boot requires `make reset`.
POSTGRES_USER=curator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=curator

# Anthropic. Not used until Step 4.
ANTHROPIC_API_KEY=

# true: LLM calls return canned fixtures and never reach the API.
DRY_RUN=true

# true: narrative + challenge run on claude-opus-5 (system_design.md §10.2 diagnostic).
OPUS_DIAGNOSTIC=false

LOG_LEVEL=INFO
